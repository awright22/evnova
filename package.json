{
  "name": "marque",
  "version": "0.0.0",
  "private": true,
  "description": "Marque: a persistent multiplayer space trading and combat game.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @marque/server --filter @marque/client dev",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/soak/src/main.ts",
    "shots": "tsx tools/shots/src/main.ts",
    "perf": "tsx tools/perf/src/main.ts",
    "bot": "tsx tools/bot/src/main.ts",
    "build": "pnpm --filter @marque/server --filter @marque/client run build",
    "verify": "tsx tools/verify/src/twoClients.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
